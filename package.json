{
  "name": "vc-memory-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI Second Brain for Lean Venture Capital Teams — a memory layer that remembers every startup interaction.",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && next build",
    "start": "next start -p 3001",
    "lint": "eslint . --max-warnings=0",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "ingest:demo": "tsx scripts/ingest-demo.ts",
    "setup": "prisma db push && npm run ingest:demo",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:memory": "node --import tsx --test tests/memory-*.test.ts",
    "typecheck": "tsc --noEmit",
    "eval:memory": "node --import tsx scripts/evaluate-memory.ts",
    "eval:memory:live": "node --import tsx scripts/evaluate-memory-live.ts",
    "eval:memory:provider": "node --import tsx scripts/evaluate-memory-provider.ts",
    "test:frontend": "playwright test",
    "test:ingestion": "node --import tsx --test tests/ingestion-idempotency.test.ts",
    "test:ingestion:db": "node scripts/test-ingestion-db.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "groq-sdk": "^1.2.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "pdf-parse": "^1.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.17.10",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.1",
    "dotenv": "^16.4.5",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.33",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.5"
    }
  }
}
